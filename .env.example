# ---------------------------------------------------------------------------
# Conflux Liquidity & Execution Analytics - example environment configuration.
#
# Copy this file to `.env` and adjust. Every variable is optional: the defaults
# in config/default.yaml are used when a variable is absent. Never commit a
# real `.env` file. This project needs no API keys and no private keys.
# ---------------------------------------------------------------------------

# --- Network / RPC ---------------------------------------------------------
# Conflux eSpace mainnet defaults. Override for the testnet (chain 71) with
# CONFLUX_RPC_URL=https://evmtestnet.confluxrpc.com and CONFLUX_CHAIN_ID=71.
CONFLUX_NETWORK=mainnet
CONFLUX_RPC_URL=https://evm.confluxrpc.com
CONFLUX_WS_RPC_URL=
CONFLUX_CHAIN_ID=1030
CONFLUX_EXPLORER_URL=https://evm.confluxscan.org
CONFLUX_EXPLORER_API_URL=
RPC_TIMEOUT_SECONDS=20.0
RPC_MAX_RETRIES=3
RPC_RETRY_BACKOFF_SECONDS=0.5

# --- Storage ---------------------------------------------------------------
CONFLUX_ANALYTICS_DB=data/conflux_analytics.db

# --- Collector -------------------------------------------------------------
LOG_CHUNK_SIZE=2000
START_BLOCK=
END_BLOCK=
MAX_BLOCKS_PER_RUN=20000
MAX_POOLS=25
MIN_POOL_RESERVE_USD=
CHECKPOINT_ENABLED=true

# --- DEX adapters ----------------------------------------------------------
# Comma separated list of dex_id values to enable (see config/dexes.yaml).
DEXS_ENABLED=swappi_v2,vswap_v3

# --- Execution analytics ---------------------------------------------------
# Comma separated "label:amount" pairs in whole input-token units. Use an
# explicit raw amount with "label:raw:<integer>" when a token-specific integer
# amount is required.
TRADE_SIZES=small:1,medium:10,large:100

# --- Pricing ---------------------------------------------------------------
# Explicit stablecoin peg assumptions, JSON object of {address: price}.
# Empty by default: USD fields stay null unless a peg is declared here or a
# DEX-derived price path exists. Assumptions must be documented and are always
# labelled with their source.
PRICE_STABLECOIN_PEGS={}
# Optional external market price API (disabled by default; the MVP has no
# dependency on paid APIs).
PRICE_EXTERNAL_API_ENABLED=false
PRICE_EXTERNAL_API_URL=

# --- API / dashboard -------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=

# --- Reporting -------------------------------------------------------------
REPORT_DIR=reports